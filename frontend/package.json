{
  "name": "fikaai-student-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:student": "vite --mode student",
    "dev:admin": "vite --mode admin",
    "dev:instructor": "vite --mode instructor",
    "build": "npm run build:all",
    "build:student": "tsc -b && vite build --mode student",
    "build:admin": "tsc -b && vite build --mode admin",
    "build:instructor": "tsc -b && vite build --mode instructor",
    "build:all": "npm run build:student && npm run build:admin && npm run build:instructor",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vitejs/plugin-react": "latest",
    "axios": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "latest",
    "jsdom": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "vitest": "latest"
  }
}
