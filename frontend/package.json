{
  "name": "ccd-attendance-student-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:student": "vite --mode student",
    "dev:admin": "vite --mode admin",
    "dev:instructor": "vite --mode instructor",
    "build": "npm run build:all",
    "build:student": "tsc -b && vite build --mode student",
    "build:admin": "tsc -b && vite build --mode admin",
    "build:instructor": "tsc -b && vite build --mode instructor",
    "build:all": "npm run build:student && npm run build:admin && npm run build:instructor",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.22",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vitest": "^3.2.4"
  }
}
