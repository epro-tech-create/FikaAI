# ============================================================
# FikaAI Attendance System - environment configuration
# Copy to `.env` and adjust values. NEVER commit real secrets.
# ============================================================

# ---------- Database ----------
POSTGRES_USER=fikaai
POSTGRES_PASSWORD=fikaai_dev
POSTGRES_DB=fikaai_db
# Docker Compose hostname is `db`; for non-Docker dev use localhost:5433
DATABASE_URL=postgresql+asyncpg://fikaai:fikaai_dev@localhost:5433/fikaai_db

# ---------- Security ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-insecure-jwt-secret-change-me-please-1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key used to encrypt facial embeddings at rest.
# Generate with: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Leave EMPTY in development to have an ephemeral key generated at startup
# (WARNING: stored embeddings become unreadable after a restart until re-enrolled).
EMBEDDING_ENCRYPTION_KEY=

# ---------- Face AI ----------
# insightface = buffalo_l pack (ArcFace, CPU). fake = dev/demo only, NEVER production.
FACE_EMBEDDING_PROVIDER=insightface
# Initial DEVELOPMENT value only - calibrate before real deployment (see docs/THRESHOLD_CALIBRATION.md)
FACE_MATCH_THRESHOLD=0.45
# Minimum mean pairwise cosine similarity across enrolment samples
FACE_MIN_CONSISTENCY=0.35
# When FACE_EMBEDDING_PROVIDER=fake, every detection yields the SAME vector so the
# whole flow can be demoed without model weights. Dev machines only!
FAKE_FACE_ALWAYS_MATCH=true
# Local directory holding model weights (buffalo_l/, face_landmarker.task)
MODELS_DIR=./models_data
INSIGHTFACE_DET_SIZE=640
# Ignore secondary detections smaller than this fraction of the main face.
FACE_MIN_RELATIVE_AREA=0.25

# ---------- Campus timezone ----------
# Used to evaluate session dates/times regardless of server TZ
CAMPUS_TIMEZONE=Africa/Dar_es_Salaam
# Development city-wide point: Dar es Salaam. Replace with the exact premises for production.
TRAINING_LATITUDE=-6.7924000
TRAINING_LONGITUDE=39.2083000
TRAINING_RADIUS_METERS=50000

# ---------- Liveness ----------
LIVENESS_CHALLENGE_TTL_SECONDS=120

# ---------- Geofencing ----------
GPS_VERIFICATION_ENABLED=false
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_AGE_SECONDS=120

# ---------- One-time verification tokens ----------
LOCATION_TOKEN_TTL_SECONDS=300
FACE_TOKEN_TTL_SECONDS=300

# ---------- Attendance ----------
DEFAULT_LATE_THRESHOLD_MINUTES=15

# ---------- Upload limits ----------
MAX_FRAMES_PER_REQUEST=60
MAX_FRAME_BYTES=400000
MAX_SAMPLE_BYTES=800000

# ---------- CORS ----------
# One origin per served application (student, administrator, instructor)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# ---------- Rate limits (slowapi "count/duration" strings) ----------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FACE=10/minute
RATE_LIMIT_ATTENDANCE=20/minute

# ---------- Frontend ----------
VITE_API_BASE_URL=/api
