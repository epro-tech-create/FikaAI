# ============================================================
# CCD-Attendance production configuration - Vercel + Render + Neon
# Values below are pasted into each provider's dashboard.
# NEVER commit real secrets.
# The legacy single-VPS layout (docker-compose.prod.yml) is still
# supported; this file now documents the managed-cloud split.
# ============================================================

# ---------- 1. NEON (managed Postgres) ----------
# Copy the connection string from the Neon console, then convert it for
# SQLAlchemy + asyncpg before pasting it into Render as DATABASE_URL:
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&channel_binding=require
# becomes
#   postgresql+asyncpg://user:pass@ep-xxx.neon.tech/db?ssl=require
# Changes: scheme -> postgresql+asyncpg , sslmode=require -> ssl=require ,
# drop channel_binding , and prefer the DIRECT endpoint (no -pooler) initially.
DATABASE_URL=postgresql+asyncpg://user:password@ep-endpoint.region.aws.neon.tech/fikaai?ssl=require

# ---------- 2. RENDER (FastAPI backend web service) ----------
# JWT_SECRET is auto-generated by render.yaml (generateValue: true).
# Generate the persistent Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up securely - losing it makes existing FaceIDs unreadable.
EMBEDDING_ENCRYPTION_KEY=replace_with_a_persistent_fernet_key

# Production origins (exact scheme + host, no trailing slash) - include custom domain attendance.cyberclubdit.org
CORS_ORIGINS=https://attendance.cyberclubdit.org,https://fikaai-student.vercel.app,https://fikaai-admin.vercel.app,https://fikaai-instructor.vercel.app

FACE_EMBEDDING_PROVIDER=insightface
INSIGHTFACE_MODEL_NAME=buffalo_sc
FAKE_FACE_ALWAYS_MATCH=false
MODELS_DIR=/app/models_data
WEB_CONCURRENCY=1

# Campus timezone for session evaluation
CAMPUS_TIMEZONE=Africa/Dar_es_Salaam
TRAINING_LATITUDE=-6.8137482
TRAINING_LONGITUDE=39.2801352
TRAINING_RADIUS_METERS=100
TRAINING_LOCATION_NAME=DIT RAFIC Building
TRAINING_LOCATION_ADDRESS=Dar es Salaam Institute of Technology, RAFIC Building
GPS_VERIFICATION_ENABLED=true
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_AGE_SECONDS=120

LIVENESS_CHALLENGE_TTL_SECONDS=120
LOCATION_TOKEN_TTL_SECONDS=300
FACE_TOKEN_TTL_SECONDS=300
DEFAULT_LATE_THRESHOLD_MINUTES=15
MAX_FRAMES_PER_REQUEST=60
MAX_FRAME_BYTES=400000
MAX_SAMPLE_BYTES=800000

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FACE=10/minute
RATE_LIMIT_ATTENDANCE=20/minute

# ---------- 3. VERCEL / VPS (three projects from ./frontend) ----------
# Project settings: Root Directory = frontend, Framework = Vite,
# Install = npm ci, Build per project:
#   student    -> npm run build:student
#   admin      -> npm run build:admin
#   instructor -> npm run build:instructor
# Environment variables for EVERY project:
VITE_APP_ROLE=student # admin | instructor for the other two projects
VITE_API_BASE_URL=https://fikaai-backend.onrender.com/api
# Student project only (public landing page instructor sign-in link):
VITE_INSTRUCTOR_APP_URL=https://attendance.cyberclubdit.org
# ---------- 3b. GOOGLE SEO (student project only - attendance.cyberclubdit.org) ----------
# Google Search Console: https://search.google.com/search-console -> HTML tag -> copy token
VITE_GOOGLE_SITE_VERIFICATION=REPLACE_WITH_GOOGLE_VERIFICATION_TOKEN
# Google Analytics 4: https://analytics.google.com -> Admin -> Data Streams -> Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
