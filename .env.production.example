# Public hostname. Create a DNS A/AAAA record pointing this name at your VPS.
DOMAIN=attendance.example.com
ACME_EMAIL=admin@example.com

# Use URL-safe values. Generate the password with: openssl rand -hex 24
POSTGRES_USER=fikaai
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password
POSTGRES_DB=fikaai_db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_64_character_random_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up securely. Losing it makes existing FaceIDs unreadable.
EMBEDDING_ENCRYPTION_KEY=replace_with_a_persistent_fernet_key

FACE_EMBEDDING_PROVIDER=insightface
FAKE_FACE_ALWAYS_MATCH=false
FACE_MATCH_THRESHOLD=0.45
FACE_MIN_CONSISTENCY=0.35
FACE_MIN_RELATIVE_AREA=0.25
INSIGHTFACE_DET_SIZE=640
WEB_CONCURRENCY=1

CAMPUS_TIMEZONE=Africa/Dar_es_Salaam
TRAINING_LATITUDE=-6.7924000
TRAINING_LONGITUDE=39.2083000
TRAINING_RADIUS_METERS=50
GPS_VERIFICATION_ENABLED=false
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_AGE_SECONDS=120

LIVENESS_CHALLENGE_TTL_SECONDS=120
LOCATION_TOKEN_TTL_SECONDS=300
FACE_TOKEN_TTL_SECONDS=300
DEFAULT_LATE_THRESHOLD_MINUTES=15
MAX_FRAMES_PER_REQUEST=60
MAX_FRAME_BYTES=400000
MAX_SAMPLE_BYTES=800000

# Must exactly match DOMAIN and use HTTPS.
CORS_ORIGINS=https://attendance.example.com
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FACE=10/minute
RATE_LIMIT_ATTENDANCE=20/minute
